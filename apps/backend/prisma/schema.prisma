generator client {
  provider        = "prisma-client-js"

}
datasource db {
  provider = "sqlite"
}


// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum CategoriaMaterial {
  CANO_AGUA
  CANO_CLOACA
  CANO_GAS
  CANO_ELECTRICO
  ACCESORIO_PLOMERIA
  VALVULA
  TANQUE
  HERRAMIENTA
  OTRO
}

enum UnidadMedida {
  UNIDAD
  METRO
}

enum CreadoPorAlias {
  SISTEMA
  DEPOSITO
}

enum EstadoPedido {
  PENDIENTE_REVISION
  CONFIRMADO
  REMITO_GENERADO
}

enum EstadoResolucion {
  RESUELTO_AUTOMATICO
  PENDIENTE_CONFIRMACION
  SIN_MATCH
}

enum TipoArchivo {
  PDF
  IMAGEN
}

enum EstadoStock {
  PENDIENTE
  APLICADO
  STOCK_PENDIENTE
}

enum EstadoFaltanteObra {
  PENDIENTE
  EN_COMPRA
  RESUELTO
}

enum EstadoRecepcion {
  COMPLETA
  CON_DIFERENCIAS
}

enum TipoSync {
  PRODUCTOS
  STOCK
}

enum EstadoSync {
  EN_PROCESO
  COMPLETADO
  ERROR
}

// ─── MATERIALES ──────────────────────────────────────────────────────────────

model Material {
  id               String            @id @default(uuid())
  codigoProveedor  String?
  nombreOficial    String
  categoria        CategoriaMaterial
  unidadStock      UnidadMedida
  unidadPedido     UnidadMedida
  longitudEstandar Float?
  activo           Boolean           @default(true)
  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt

  alias              Alias[]
  itemsPedido        ItemPedido[]
  itemsRemito        ItemRemito[]
  itemsRemitoEntrada ItemRemitoEntrada[]
  itemsRecepcion     ItemRecepcion[]
  faltantesObra      FaltanteObra[]
  faltantesProveedor FaltanteProveedor[]
  stockItems         StockItem[]
}

model Alias {
  id         String         @id @default(uuid())
  texto      String         @unique
  materialId String
  creadoPor  CreadoPorAlias @default(SISTEMA)
  creadoEn   DateTime       @default(now())

  material Material @relation(fields: [materialId], references: [id])
}

// ─── OBRAS ───────────────────────────────────────────────────────────────────

model Obra {
  id    String  @id @default(uuid())
  nombre String
  activa Boolean @default(true)

  proveedores    ObraProveedor[]
  pedidos        Pedido[]
  remitosEntrada RemitoEntrada[]
  recepciones    Recepcion[]
  faltantesObra  FaltanteObra[]
  stockItems     StockItem[]
}

model ObraProveedor {
  id                   String  @id @default(uuid())
  obraId               String
  proveedor            String
  spreadsheetIdStock   String
  spreadsheetIdControl String
  activo               Boolean @default(true)

  obra Obra @relation(fields: [obraId], references: [id])
}

// ─── PEDIDOS ─────────────────────────────────────────────────────────────────

model Pedido {
  id              String       @id @default(uuid())
  obraId          String
  solicitante     String
  fechaPedido     DateTime
  fechaCarga      DateTime     @default(now())
  archivoOriginal String
  tipoArchivo     TipoArchivo
  estado          EstadoPedido @default(PENDIENTE_REVISION)

  obra          Obra           @relation(fields: [obraId], references: [id])
  items         ItemPedido[]
  remitosSalida RemitoSalida[]
}

model ItemPedido {
  id                   String           @id @default(uuid())
  pedidoId             String
  numeroItem           Int
  textoOriginal        String
  cantidadOriginal     String
  cantidadNormalizada  Float
  unidadPedido         String
  materialId           String?
  estadoResolucion     EstadoResolucion
  scoreResolucion      Float?
  confirmadoPor        String?

  pedido   Pedido    @relation(fields: [pedidoId], references: [id])
  material Material? @relation(fields: [materialId], references: [id])
}

// ─── REMITOS SALIDA ──────────────────────────────────────────────────────────

model RemitoSalida {
  id                  String      @id @default(uuid())
  pedidoId            String
  obraId              String
  numeroRemito        Int         @unique
  solicitante         String
  encargadoDeposito   String
  encargadoTraslado   String
  fechaPedidoObra     DateTime
  fechaRetiroDeposito DateTime
  archivoExcel        String
  estadoStock         EstadoStock @default(PENDIENTE)
  intentosDescuento   Int         @default(0)
  ultimoIntentoEn     DateTime?

  pedido Pedido       @relation(fields: [pedidoId], references: [id])
  items  ItemRemito[]

  @@index([pedidoId])
}

model ItemRemito {
  id               String   @id @default(uuid())
  remitoId         String
  materialId       String?
  descripcion      String
  cantidadPedida   Float
  unidad           String
  cantidadEnStock  Float
  cantidadFaltante Float    @default(0)
  condicionEntrega String?
  observaciones    String?

  remito   RemitoSalida @relation(fields: [remitoId], references: [id])
  material Material?    @relation(fields: [materialId], references: [id])

  faltanteObra FaltanteObra?
}

// ─── REMITOS ENTRADA ─────────────────────────────────────────────────────────

model RemitoEntrada {
  id                   String   @id @default(uuid())
  obraId               String
  proveedor            String
  numeroRemito         String
  fechaRemito          DateTime
  fechaCarga           DateTime @default(now())
  asociadoARecepcion   Boolean  @default(false)

  obra  Obra               @relation(fields: [obraId], references: [id])
  items ItemRemitoEntrada[]
}

model ItemRemitoEntrada {
  id                   String  @id @default(uuid())
  remitoEntradaId      String
  codigoProveedor      String
  descripcionProveedor String
  cantidad             Float
  unidad               String?
  materialId           String?

  remitoEntrada RemitoEntrada @relation(fields: [remitoEntradaId], references: [id])
  material      Material?     @relation(fields: [materialId], references: [id])
}

// ─── RECEPCIONES ─────────────────────────────────────────────────────────────

model Recepcion {
  id             String          @id @default(uuid())
  obraId         String
  proveedor      String
  numeroRemito   String
  numeroFactura  String
  fechaRemito    DateTime
  fechaRecepcion DateTime        @default(now())
  estado         EstadoRecepcion @default(COMPLETA)

  obra               Obra                @relation(fields: [obraId], references: [id])
  items              ItemRecepcion[]
  faltantesProveedor FaltanteProveedor[]
}

model ItemRecepcion {
  id                   String  @id @default(uuid())
  recepcionId          String
  materialId           String
  descripcionProveedor String
  codigoProveedor      String
  cantidadFacturada    Float
  cantidadRecibida     Float
  diferencia           Float
  tieneFaltante        Boolean @default(false)

  recepcion Recepcion @relation(fields: [recepcionId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])
}

model FaltanteProveedor {
  id                String   @id @default(uuid())
  recepcionId       String
  obraId            String
  proveedor         String
  numeroFactura     String
  numeroRemito      String
  materialId        String
  cantidadFacturada Float
  cantidadRecibida  Float
  diferencia        Float
  fechaRemito       DateTime
  resuelto          Boolean  @default(false)
  fechaResolucion   DateTime?

  recepcion Recepcion @relation(fields: [recepcionId], references: [id])
  material  Material  @relation(fields: [materialId], references: [id])
}

// ─── FALTANTES OBRA ──────────────────────────────────────────────────────────

model FaltanteObra {
  id               String             @id @default(uuid())
  remitoSalidaId   String
  itemRemitoId     String             @unique
  obraId           String
  materialId       String
  descripcion      String
  cantidadPedida   Float
  cantidadFaltante Float
  unidad           String
  estado           EstadoFaltanteObra @default(PENDIENTE)
  observaciones    String?
  creadoEn         DateTime           @default(now())
  resueltaEn       DateTime?

  obra        Obra         @relation(fields: [obraId], references: [id])
  material    Material     @relation(fields: [materialId], references: [id])
  itemRemito  ItemRemito   @relation(fields: [itemRemitoId], references: [id])
}

// ─── STOCK ───────────────────────────────────────────────────────────────────

model StockItem {
  id            String   @id @default(uuid())
  obraId        String
  proveedor     String
  materialId    String
  cantidad      Float    @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  obra     Obra     @relation(fields: [obraId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([obraId, proveedor, materialId])
}

// ─── FINNEGANS SYNC ──────────────────────────────────────────────────────────

model SyncLog {
  id                   String     @id @default(uuid())
  tipo                 TipoSync
  fechaInicio          DateTime   @default(now())
  fechaFin             DateTime?
  estado               EstadoSync @default(EN_PROCESO)
  productosActualizados Int       @default(0)
  error                String?
}